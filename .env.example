# ------------------------------------------------------------------
# FrameFlow — environment configuration
# Copy to .env and fill in values. NEVER commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/frameflow"

# Secret used to hash session tokens. Required, min 32 chars.
# Generate one: openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Which text-to-video provider to use: mock | replicate | fal
# "mock" is DEVELOPMENT ONLY (simulated generations, sample video).
# Production refuses to start with mock.
VIDEO_PROVIDER="mock"

# --- Replicate (VIDEO_PROVIDER=replicate) --------------------------
# Get a token at https://replicate.com/account/api-tokens (paid usage)
# REPLICATE_API_TOKEN="r8_..."
# Model to run (any Replicate text-to-video model):
# REPLICATE_VIDEO_MODEL="wan-video/wan-2.2-t2v-fast"

# --- fal.ai (VIDEO_PROVIDER=fal) -----------------------------------
# Get a key at https://fal.ai/dashboard/keys (paid usage)
# FAL_KEY="..."
# FAL_VIDEO_MODEL="fal-ai/ltx-video"

# --- Optional: LLM prompt enhancement ------------------------------
# With a key, prompts are rewritten by Claude before generation.
# Without one, a deterministic rule-based enhancer is used.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-4-5"

# --- Optional: provider webhooks -----------------------------------
# Set both to receive push status updates instead of polling only.
# APP_URL must be publicly reachable (e.g. your production domain).
# APP_URL="https://your-domain.com"
# WEBHOOK_SECRET="another-long-random-string"
