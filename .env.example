# ------------------------------------------------------------------
# FrameFlow — environment configuration
# Copy to .env and fill in values. NEVER commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/frameflow"

# Secret used to hash session tokens. Required, min 32 chars.
# Generate one: openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Which text-to-video provider to use: mock | local | replicate | fal
#   local     — RECOMMENDED: self-hosted open-source model via the bundled
#               Python worker (worker/). No external AI service, no API key.
#   mock      — DEVELOPMENT ONLY (simulated generations, sample video).
#               Production refuses to start with mock.
#   replicate / fal — optional paid cloud providers.
VIDEO_PROVIDER="mock"

# --- Self-hosted worker (VIDEO_PROVIDER=local) ---------------------
# Where the Next.js server reaches the worker:
# LOCAL_WORKER_URL="http://127.0.0.1:8001"
# Where the BROWSER reaches the worker for video playback
# (defaults to LOCAL_WORKER_URL; set this if the worker runs on
#  another machine/port that the browser sees differently):
# LOCAL_WORKER_PUBLIC_URL="http://127.0.0.1:8001"
# Optional shared secret — must match WORKER_TOKEN on the worker:
# LOCAL_WORKER_TOKEN=""

# --- Replicate (VIDEO_PROVIDER=replicate, optional) ----------------
# Get a token at https://replicate.com/account/api-tokens (paid usage)
# REPLICATE_API_TOKEN="r8_..."
# REPLICATE_VIDEO_MODEL="wan-video/wan-2.2-t2v-fast"

# --- fal.ai (VIDEO_PROVIDER=fal, optional) -------------------------
# Get a key at https://fal.ai/dashboard/keys (paid usage)
# FAL_KEY="..."
# FAL_VIDEO_MODEL="fal-ai/ltx-video"

# --- Optional: LLM prompt enhancement ------------------------------
# Leave unset for the fully-local, rule-based prompt enhancer.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-4-5"

# --- Optional: provider webhooks (cloud providers only) ------------
# APP_URL="https://your-domain.com"
# WEBHOOK_SECRET="another-long-random-string"
