generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Float
}

model BlogPost {
  id      Int     @id @default(autoincrement())
  title   String
  content String
}
